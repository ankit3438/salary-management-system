  "item": [
    {
      "name": "Employee Management",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees?page=0&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page number (0-indexed)"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Number of records per page"
                }
              ]
            },
            "description": "Fetch all employees with pagination"
          },
          "response": []
        },
        {
          "name": "Search Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees/search?search=john&department=Engineering&country=India&status=ACTIVE&page=0&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "search"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "john",
